{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,

  "modules-left": [
    "custom/arch",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "pulseaudio",
    "network"
  ],

  "custom/arch": {
    "format": "",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "disable-scroll": true,
    "sort-by-number": true,
    "persistent-workspaces": {
    "*": [1, 2, 3, 4]
  }
  },

 "clock": {
  "format": "{:%a %d %b  •  %H:%M}",
  "tooltip-format": "{:%A, %d %B %Y}",
  "interval": 1
},

  "cpu": {
  "format": "  {usage}%",
  "interval": 2
},

"memory": {
  "format": "  {percentage}%",
  "interval": 2,
  "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
},

"pulseaudio": {
  "format": "  {volume}%",
  "format-muted": "  MUTE",
  "on-click": "pavucontrol",
  "scroll-step": 5
},

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "ETH",
    "format-disconnected": "OFF",
    "on-click": "nm-connection-editor",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}"
  },

  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "CHG {capacity}%",
    "format-full": "BAT 100%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  }
}