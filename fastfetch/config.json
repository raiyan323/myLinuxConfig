{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "height": 8,
        "padding": {
            "top": 0
        }
    },

    "display": {
        "percent": {
            "type": 9
        },
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "bright_yellow",
                "at": "bright_black",
                "host": "bright_red"
            }
        },

        {
            "type": "separator",
            "string": "──────────────"
        },

        {
            "type": "os",
            "key": "󰣇  OS        "
        },

        {
            "type": "kernel",
            "key": "󰌽  Kernel    "
        },

        {
            "type": "packages",
            "key": "󰏓  Packages  "
        },

        {
            "type": "shell",
            "key": "  Shell     "
        },

        {
            "type": "wm",
            "key": "  Desktop   "
        },

        {
            "type": "theme",
            "key": "  Theme     "
        },

        {
            "type": "terminal",
            "key": "  Terminal  "
        },

        {
            "type": "memory",
            "key": "󰍛  Memory    "
        },

        "break",

        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}